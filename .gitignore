# ── Root level (legacy node_modules from pre-reorganization) ────────────────
node_modules/

# ── Frontend ────────────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/*.local

# ── Backend ─────────────────────────────────────────────────────────────────
# Python virtualenvs
backend/venv/
backend/.venv/
backend/env/

# Uploaded videos (temp files)
backend/uploads/*
!backend/uploads/.gitkeep

# Model checkpoints — never commit weights
backend/models/*.pth
backend/models/*.pt
backend/models/*.bin
backend/models/*.ckpt
!backend/models/.gitkeep

# Generated artifacts
backend/artifacts/*
!backend/artifacts/.gitkeep

# Python cache
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/**/*.pyo
*.pyc
*.pyo
__pycache__/

# ── Shared ───────────────────────────────────────────────────────────────────
# Environment variables — never commit secrets
.env
.env.local
.env.*.local

# Editor directories
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Previously generated output / temp folders
output/
tmp/
.vite/
